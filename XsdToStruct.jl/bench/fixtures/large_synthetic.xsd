<?xml version="1.0"?>
<!-- Synthetic large fixture for Phase 0 of the XML backend bake-off / perf plan
     (~/.claude/plans/dynamic-churning-abelson.md). Shape mimics a repeated-record financial
     message (many sibling entries, each with a handful of mixed-type scalar fields) without
     being a literal copy of any real ISO 20022 schema - no licensing question. The XML instance
     is generated by gen_large_fixture.jl to whatever record count a benchmark run needs. -->
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:LargeSynthetic="LargeSynthetic" targetNamespace="LargeSynthetic">

    <element name="document" type="LargeSynthetic:documentType"/>

    <simpleType name="CurrencyCode">
        <restriction base="string">
            <pattern value="[A-Z]{3}"/>
        </restriction>
    </simpleType>

    <complexType name="EntryType">
        <annotation>
            <documentation>A single repeated record - the element this fixture stresses at scale.</documentation>
        </annotation>
        <sequence>
            <element name="EntryId" type="string"/>
            <element name="Amount" type="decimal"/>
            <element name="Currency" type="LargeSynthetic:CurrencyCode"/>
            <element name="BookingDate" type="dateTime"/>
            <element name="CreditDebitIndicator" type="boolean"/>
            <element name="Reference" type="string"/>
        </sequence>
    </complexType>

    <complexType name="documentType">
        <sequence>
            <element name="Entry" type="LargeSynthetic:EntryType" maxOccurs="unbounded"/>
        </sequence>
    </complexType>

</schema>
